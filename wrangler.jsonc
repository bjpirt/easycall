{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "easycall",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    // The Worker checks the group before serving the app; built assets and icons skip it.
    "run_worker_first": ["/*", "!/assets/*", "!/icons/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  "vars": {
    // How long the receiver waits for a call before going back to idle.
    "READY_WINDOW_MINUTES": "30",
    // How long a dropped connection's place in a call is held for them to reconnect.
    "GRACE_SECONDS": "30",
  },
  // Secrets (DIRECTORY, TURN_KEY_ID, TURN_KEY_API_TOKEN) are optional and typed in
  // src/worker/env.d.ts. Listing none here stops `wrangler types` inferring them
  // from a local .dev.vars, so generated types are the same locally and in CI.
  "secrets": { "required": [] },
  "observability": {
    "enabled": true,
  },
}
